{
    email admin@marxh.net

    acme_dns cloudflare {env.CF_API_TOKEN}
}

nginx3.marxh.net {

    encode gzip zstd

    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    @hello host marxh.net

    handle @hello {
        root * /srv/hello
        file_server
    }

    @immich host immich.marxh.net
    handle @immich {
        reverse_proxy 192.168.1.20:2283
    }

    @jellyfin host jellyfin.marxh.net
    handle @jellyfin {
        reverse_proxy 192.168.1.30:8096
    }

    @nextcloud host cloud.marxh.net
    handle @nextcloud {
        reverse_proxy 192.168.1.40:443 {
            transport http {
                tls
            }
        }
    }

    handle {
        respond "Unknown host" 404
    }
}